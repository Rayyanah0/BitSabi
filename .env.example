# Copy this file to .env for local development. Never commit .env.

# development | test | production
APP_ENV=development

# Address the BitSabi API listens on.
BIND_ADDR=127.0.0.1:3000

# The browser origin allowed to call the API during development.
FRONTEND_ORIGIN=http://localhost:8080

# Logging filter.
RUST_LOG=bitsabi_server=debug,tower_http=info

# PostgreSQL is introduced in Milestone 4. Keep this value as a placeholder until then.
DATABASE_URL=postgres://bitsabi:change-me@localhost:5432/bitsabi

# MVP safety switches. Do not enable mainnet or real payments in the MVP.
BITCOIN_NETWORK=testnet
PAYMENTS_MODE=mock

# Esplora-compatible Bitcoin testnet provider. Mainnet endpoints are not supported.
TESTNET_API_URL=https://blockstream.info/testnet/api
# Optional fallback provider used when the primary is unavailable.
TESTNET_API_FALLBACK_URL=
